# Where each block goes:
#   contracts  -> contracts/.env
#   backend    -> backend/.env (or the repo-root .env)
#   sdk / web  -> web/.env.local  (Next.js only reads .env* from web/, never the repo root)

# Monad testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# contracts (Person 1)
DEPLOYER_PRIVATE_KEY=
UPDATER_ADDRESS=

# backend (Person 2)
UPDATER_PRIVATE_KEY=
BACKEND_PORT=4000
MON_USD_FALLBACK=0.05

# sdk / web (Person 4 / Person 3) -> web/.env.local
# All optional: the root scripts set NEXT_PUBLIC_MOCK (`pnpm dev` = 0, `pnpm dev:mock` = 1)
# and the sdk falls back to the public RPC and http://localhost:4000.
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_MOCK=0
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
